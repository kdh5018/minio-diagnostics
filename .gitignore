# Public source allowlist. Operational data stays local, even when using git add .
/*
!/.gitignore
!/.gitattributes
!/README.md
!/aistordoctor.py
!/analyze.py
!/run_tests.py
!/verify_browser.cjs
!/R1_ACCEPTANCE.md
!/r2_health.py
!/r2_enrichment.py
!/test_r2.py
!/run-report.sh
!/build-release.sh
!/test_shell_release.py
!/LICENSE
!/docs/
/docs/*
!/docs/IMPROVEMENT_PLAN.md
!/docs/USAGE.md
!/docs/DEVELOPMENT.md
!/docs/HISTORY.md
